
#ExportPanel,
#ExportPanel #ScrollContent,
#ExportPanel QScrollArea,
#ExportPanel QScrollArea > QWidget > QWidget {
    background-color: #313244;
    border: none;
}

#ExportPanel {
    border: 1px solid #45475a;
    border-radius: 12px;
    min-width: 400px;
    max-width: 450px;
}

/* ---------- Заголовок панели ---------- */
#ExportPanel #PanelTitle {
    color: #cdd6f4;
    font-size: 16px;
    font-weight: bold;
    padding-bottom: 12px;
    background-color: transparent;
}

/* ---------- Текстовые метки ---------- */
#ExportPanel QLabel {
    color: #cdd6f4;
    background-color: transparent;
}

/* ---------- Чекбоксы и Радиокнопки ---------- */
#ExportPanel QCheckBox,
#ExportPanel QRadioButton {
    color: #ffffff;          /* Белый цвет текста */
    font-size: 15px;         /* Увеличенный шрифт (было ~13) */
    background-color: transparent;
    spacing: 10px;           /* Расстояние между кружком и текстом */
    padding: 4px 0px;        /* Вертикальные отступы (хитбокс и текст) */
}

/* Стили для индикаторов (кружков/квадратиков) */
#ExportPanel QCheckBox::indicator,
#ExportPanel QRadioButton::indicator {
    width: 20px;             /* Увеличенный размер (было 18) */
    height: 20px;
    border: 2px solid #89b4fa;
    background-color: #1e1e2e;
}

/* Квадратные для чекбокса, круглые для радиокнопки */
#ExportPanel QCheckBox::indicator {
    border-radius: 4px;
}
#ExportPanel QRadioButton::indicator {
    border-radius: 11px;
}

/* Эффект при наведении */
#ExportPanel QCheckBox::indicator:hover,
#ExportPanel QRadioButton::indicator:hover {
    border-color: #a6e3a1;
}

/* Состояние "выбрано" */
#ExportPanel QCheckBox::indicator:checked {
    background-color: #89b4fa;
    border-color: #89b4fa;
}

#ExportPanel QRadioButton::indicator:checked {
    /* Заливаем фон и делаем толстую рамку, чтобы внутри остался темный кружок (эффект точки) */
    background-color: #1e1e2e;
    border: 6px solid #89b4fa;
}

/* ---------- Комбобоксы ---------- */
#ExportPanel QComboBox {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 2px solid #89b4fa;
    border-radius: 6px;
    padding: 4px 10px;
    min-width: 120px;
}

#ExportPanel QComboBox:hover,
#ExportPanel QComboBox:focus {
    border-color: #a6e3a1;
}

#ExportPanel QComboBox QAbstractItemView {
    background-color: #1e1e2e;
    color: #cdd6f4;
    selection-background-color: #45475a;
    selection-color: #89b4fa;
    border: 1px solid #45475a;
    outline: none;
}

/* ---------- Кнопки ---------- */
#ExportPanel QPushButton {
    background-color: #1e1e2e;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 8px 15px;
    font-weight: 500;
}

#ExportPanel QPushButton:hover {
    color: #89b4fa;
    border-color: #89b4fa;
}

#ExportPanel QPushButton:pressed {
    background-color: #2a2b3d;
}

#ExportPanel QPushButton:disabled {
    color: #a6adc8;
    border-color: #313244;
    background-color: #2a2b3d;
}

/* ---------- Скроллбар ---------- */
#ExportPanel QScrollBar:vertical {
    background: #1e1e2e;
    width: 10px;
    border: none;
    margin: 0;
}

#ExportPanel QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 5px;
    min-height: 20px;
}

#ExportPanel QScrollBar::handle:vertical:hover {
    background: #89b4fa;
}

#ExportPanel QScrollBar::add-line:vertical,
#ExportPanel QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
    border: none;
}

#ExportPanel QScrollBar::add-page:vertical,
#ExportPanel QScrollBar::sub-page:vertical {
    background: none;
}